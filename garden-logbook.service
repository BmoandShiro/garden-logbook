[Unit]
Description=Garden Logbook Application Startup
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=bmo
Group=bmo
WorkingDirectory=/home/bmo/garden-logbook
ExecStart=/home/bmo/garden-logbook/startup.sh
StandardOutput=journal
StandardError=journal

# Restart on failure
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
